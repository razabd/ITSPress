# ─── Docker Compose (hanya dipakai saat deploy via Docker) ───────────────────
# Domain publik aplikasi (tanpa https://)
DOMAIN=yourdomain.com
# Password user database "itspress" di container postgres
POSTGRES_PASSWORD=yourpassword

# ─── Database ────────────────────────────────────────────────────────────────
# Catatan: saat deploy via Docker Compose, nilai ini otomatis di-override
# mengarah ke container postgres (lihat docker-compose.yml)
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/itspress?sslmode=disable

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8081
GIN_MODE=release
FRONTEND_URL=https://yourdomain.com
BACKEND_PUBLIC_URL=https://yourdomain.com

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_here

# ─── SMTP (Gmail + App Password) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ─── Midtrans ────────────────────────────────────────────────────────────────
MIDTRANS_ENV=sandbox
MERCHANT_ID=your_merchant_id
CLIENT_KEY=Mid-client-xxxx
SERVER_KEY=Mid-server-xxxx

# ─── Readium LCP Server ──────────────────────────────────────────────────────
LCP_SERVER_URL=http://localhost:8989
LCP_SERVER_LOGIN=admin
LCP_SERVER_PASSWORD=yourpassword
LCP_ENCRYPT_BIN=lcpencrypt
LCP_PROVIDER=https://itspress.its.ac.id

# ─── Readium LSD Server ──────────────────────────────────────────────────────
LSD_SERVER_URL=http://localhost:8990
LSD_SERVER_LOGIN=admin
LSD_SERVER_PASSWORD=yourpassword

# ─── Seed Data (opsional — dipakai oleh `go run seed.go`) ────────────────────
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=change_me
SEED_PUBLISHER_NAME=ITS Press
SEED_PUBLISHER_EMAIL=publisher@yourdomain.com
SEED_PUBLISHER_PASSWORD=change_me